/env
*.env
*.DS_Store
*.toml

**/site/*


# AssetForge build venv (never committed)
scripts/assets/.venv/
scripts/assets/__pycache__/

# gif_creator scratch (raw webm + palette, intermediate to the committed .gif)
reports/screens/**/_video_*/

# AudioForge build venv (never committed)
tools/audio_forge/.venv/
tools/audio_forge/__pycache__/

# Build output. Reproducible via npm run build and size-gated by
# frontend/scripts/build_diet_verify.mjs. Committing it invited a reviewer to
# conclude the shipped bundle was two files (TR-025).
frontend/dist/

# MULTI-TRACK PROTOCOL rule 11: every track session works in its own git
# worktree at worktrees/<track>/. Ignored so a worktree can never be committed
# and can never reach a build.
worktrees/

# Convention (h.1): proof and gate scripts write here, never into committed
# evidence directories. See frontend/scripts/lib/evidencePaths.mjs.
.evidence-scratch/

# The owner's local preview server, per rule 12. Holds the pidfile that lets a
# run stop exactly the instance the PREVIOUS run started, and that server's log.
# Machine state, never repository state: it names a pid on one machine.
.owner-preview/

# Proof-script scratch. Convention (h.1): a gate or proof writes here by default
# and only writes into a committed evidence directory when passed --out= by a job
# that says that is what it is doing.
.scratch/
